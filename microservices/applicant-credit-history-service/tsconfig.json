{
    "compilerOptions":  {
                            "module":  "commonjs",
                            "target":  "ES2021",
                            "moduleResolution":  "node",
                            "strict":  true,
                            "esModuleInterop":  true,
                            "emitDecoratorMetadata":  true,
                            "experimentalDecorators":  true,
                            "skipLibCheck":  true,
                            "outDir":  "dist",
                            "rootDir":  "src",
                            "sourceMap":  true,
                            "inlineSources":  true
                        },
    "include":  [
                    "src/**/*.ts"
                ]
}